# ============================================================================
# Girando — variables de entorno.   cp .env.example .env
# Este archivo NO tiene secretos reales. Los valores "dev-" sirven solo para tu máquina.
# .env está en .gitignore: nunca lo subas a Git.
# ============================================================================
ENV=development
PUBLIC_BASE_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100
LOG_LEVEL=INFO

# --- PostgreSQL (usá solo letras y números en las contraseñas: van dentro de una URL)
POSTGRES_DB=girando
POSTGRES_USER=girando
POSTGRES_PASSWORD=devOwnerPassword2026
# Rol de conexión de la API (sin privilegios propios; lo crea `bootstrap-db`)
DB_API_PASSWORD=devApiPassword2026

# --- Sesiones. Generá uno propio:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-in-production-0123456789
# true obligatorio en producción (HTTPS)
COOKIE_SECURE=false

# --- Seed de desarrollo (solo ENV=development). Usuarios *@girando.test con esta contraseña. NUNCA en producción.
SEED_DEV=true
DEV_SEED_PASSWORD=Girando-dev-2026

# --- Fotos: local_dev (disco del contenedor, SOLO desarrollo) | cloudinary
IMAGE_STORAGE=local_dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Documentos privados de verificación (bucket S3-compatible; recomendado Cloudflare R2)
DOCUMENTS_BUCKET=
DOCUMENTS_ENDPOINT_URL=
DOCUMENTS_ACCESS_KEY_ID=
DOCUMENTS_SECRET_ACCESS_KEY=

# --- Mercado Pago (sandbox primero). Sin token el checkout responde "pagos no habilitados".
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- Email (none = se encolan sin enviar; en desarrollo el enlace se ve en el log de la API)
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=Girando <no-reply@girando.app>
# Remitentes por tipo (fase 3). Marketing vacío = no se envía marketing (y solo con consentimiento).
EMAIL_FROM_TRANSACTIONAL=Girando <contacto.avisos@girando.app>
EMAIL_FROM_OFFICIAL=Girando <contacto.oficial@girando.app>
EMAIL_CONTACT_ADDRESS=contacto@girando.app
EMAIL_FROM_MARKETING=

# --- Google Places (calificación externa de agencias). Sin key no se muestra nada.
GOOGLE_PLACES_API_KEY=

# --- Cotización USD: bcra (API oficial BCRA, Com. A 3500) | none
EXCHANGE_RATE_PROVIDER=bcra

# --- Puertos locales publicados por docker compose (3100/8100 para convivir con otros proyectos en 3000/8000).
# Si los cambiás, actualizá también PUBLIC_BASE_URL y CORS_ORIGINS.
WEB_PORT=3100
API_PORT=8100
